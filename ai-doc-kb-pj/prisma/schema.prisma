generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  createdAt       DateTime  @default(now())
  memberships     WorkspaceMember[]
  ownedWorkspaces Workspace[]  // 反向关系字段：Prisma 关系必须成对，缺了会报 missing an opposite relation field
}

model Workspace {
  id        String      @id @default(cuid())
  name      String
  ownerId   String
  owner     User        @relation(fields: [ownerId], references: [id])
  createdAt DateTime    @default(now())
  members   WorkspaceMember[]
  documents Document[]
}

model WorkspaceMember {
  workspaceId     String
  userId          String
  role            String      @default("owner")
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade) // 删工作区 -> 成员记录一起没了
  user            User        @relation(fields: [userId], references: [id])

  @@id([workspaceId, userId])
}

model Document {
  id            String        @id @default(cuid())
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade) // 删工作区 -> 文档一起没了
  name          String
  type          String
  size          Int
  status        String        @default("pending")
  error         String?
  uploadedBy    String
  createdAt     DateTime      @default(now())
  chunks        Chunk[]

  @@index([workspaceId, createdAt])
}

model Chunk {
  id            String      @id @default(cuid())
  documentId    String
  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade) // 删文档 -> 切片一起没
  idx           Int       // 第几片，从 0 开始
  content       String
  // Prisma 不认识 vector 类型，用 Unsupported 声明：列由裸 SQL 迁移管理
  // Prisma 不会动它：client 里不能直接读写，必须 $queryRaw/$executeRaw
  embedding     Unsupported("vector(1536)")?
  createdAt     DateTime    @default(now())
  
  @@unique([documentId, idx])   // 同文档内编号唯一：重跑管道按（documentId, idx）覆盖
}