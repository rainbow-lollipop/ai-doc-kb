DATABASE_URL="postgresql://dev:dev@localhost:5432/aidockb"
REDIS_URL="redis://localhost:6379"

# 向量化：false 时只切片不向量化（无 API key 也能跑通管道）
EMBEDDING_ENABLED=false
# OpenAI 兼容协议
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# 必须与模型的输出维度一致，也必须与迁移里的 vector（1536）一致
EMBEDDING_DIM=1536